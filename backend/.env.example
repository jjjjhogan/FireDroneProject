SECRET_KEY=your-secret-key-here
FLASK_DEBUG=true
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
DRONE_CONNECTOR=mock
ALLOW_DJI_COMMANDS=false
DJI_CLOUD_API_APP_ID=
DJI_CLOUD_API_APP_KEY=
DJI_CLOUD_API_APP_LICENSE=
DJI_CLOUD_API_MQTT_HOST=
DJI_WORKSPACE_ID=
DJI_INGEST_TOKEN=
# Leave blank to use backend/instance/dji_state.json
# DJI_STATE_FILE=
# Leave blank to use backend/instance/dji_runtime_config.json
# DJI_RUNTIME_CONFIG_FILE=
DJI_TELEMETRY_TTL_SECONDS=300
DJI_MAX_INGEST_DRONES=16
# Local Docker EMQX (see backend/docker-compose.emqx.yml): host=127.0.0.1 port=1883 use_tls=false
DJI_CLOUD_MQTT_PORT=1883
DJI_CLOUD_MQTT_USE_TLS=false
DJI_CLOUD_MQTT_USERNAME=
DJI_CLOUD_MQTT_PASSWORD=
DJI_CLOUD_MQTT_CLIENT_ID=firedrone-cloud-worker
# Optional comma-separated MQTT topics for scripts/dji_cloud_mqtt_worker.py
# DJI_CLOUD_MQTT_TOPICS=thing/product/+/osd,thing/product/+/state
# Start the in-app Cloud MQTT bridge when Flask boots (host + ingest token required)
DJI_AUTO_START_CLOUD_BRIDGE=true
FIRE_DRONE_API_BASE=http://127.0.0.1:5000/api
# Leave blank to use backend/instance/operations.sqlite3 (local dev only)
# APP_DATABASE_FILE=
# Neon / Render Postgres (production). Takes precedence over APP_DATABASE_FILE.
# DATABASE_URL=postgresql://user:pass@ep-....neon.tech/neondb?sslmode=require
AUTH_REQUIRED=false
PUBLIC_SAFETY_TOKENS=viewer-token:viewer,operator-token:operator,admin-token:admin,ingest-token:ingest
FRONTEND_APP_URL=http://127.0.0.1:8151/
# Google OAuth web client credentials from Google Cloud Console.
# Authorized redirect URI: http://127.0.0.1:5000/api/accounts/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5000/api/accounts/google/callback
GOOGLE_OAUTH_RUNTIME_CONFIG_FILE=instance/google_oauth_config.json
GOOGLE_OAUTH_RUNTIME_CONFIG_ALLOWED=true
MAP_PROVIDER=openstreetmap
MAP_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=OpenStreetMap contributors
MAP_API_KEY=
MAP_DEFAULT_BASEMAP=satellite
MAP_IMAGERY_PROVIDER=arcgis-world-imagery
MAP_IMAGERY_TILE_URL_TEMPLATE=https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
MAP_IMAGERY_ATTRIBUTION=Powered by Esri | Sources: Esri, Maxar, Earthstar Geographics, and the GIS User Community
MAP_SEARCH_PROVIDER=nominatim
NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=FireDroneProject/0.1 public-safety-prototype
MAP_SEARCH_LIMIT=5
